{
  "name": "unity-mcp-ghost",
  "version": "0.1.0",
  "private": true,
  "description": "Cursor-first MCP server and Unity editor bridge for deterministic Unity automation.",
  "type": "module",
  "bin": {
    "unity-mcp-ghost": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx server/src/index.ts",
    "format": "prettier --write \"server/**/*.ts\" \"*.json\" \"Packages/*/package.json\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"*.json\" \"Packages/*/package.json\" \"*.{js,mjs}\"",
    "generate:catalog": "tsx server/scripts/generateOperationCatalog.ts",
    "check:catalog": "tsx server/scripts/generateOperationCatalog.ts --check",
    "lint": "eslint server",
    "phase3:repair-smoke": "tsx server/src/phase3RepairSmoke.ts --transport stdio",
    "smoke": "tsx server/src/devSmoke.ts --transport stdio",
    "smoke:security": "tsx server/src/securitySmoke.ts --transport stdio",
    "smoke:runtime": "tsx server/src/runtimeSmoke.ts --transport stdio",
    "smoke:scenario": "tsx server/src/scenarioSmoke.ts --transport stdio",
    "test": "node --import tsx --test \"server/test/**/*.test.ts\"",
    "test:course": "tsx server/src/courseSmoke.ts --transport stdio --unity-project-path test-project --request-timeout-ms 60000",
    "test:protocol": "npm run check:catalog && node --import tsx --test server/test/protocol.test.ts",
    "test:unity:editmode": "tsx server/scripts/runUnityTests.ts EditMode",
    "test:unity:playmode": "tsx server/scripts/runUnityTests.ts PlayMode",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
