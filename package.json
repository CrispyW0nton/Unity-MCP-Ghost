{
  "name": "unity-mcp-ghost",
  "version": "0.1.0",
  "private": true,
  "description": "Cursor-first MCP server and Unity editor bridge for deterministic Unity automation.",
  "type": "module",
  "bin": {
    "unity-mcp-ghost": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx server/src/index.ts",
    "smoke": "tsx server/src/devSmoke.ts --transport stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
