{
  "name": "unity-mcp-ghost",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Cursor-first MCP server and Unity editor bridge for deterministic Unity automation.",
  "type": "module",
  "bin": {
    "unity-mcp-ghost": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx server/src/index.ts",
    "format": "prettier --write \"server/**/*.ts\" \"*.json\" \"Packages/*/package.json\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"*.json\" \"Packages/*/package.json\" \"*.{js,mjs}\"",
    "generate:catalog": "tsx server/scripts/generateOperationCatalog.ts",
    "check:catalog": "tsx server/scripts/generateOperationCatalog.ts --check",
    "config:client": "tsx server/scripts/generateClientConfig.ts",
    "lint": "eslint server",
    "phase3:repair-smoke": "tsx server/src/phase3RepairSmoke.ts --transport stdio --unity-project-path test-project",
    "smoke": "tsx server/src/devSmoke.ts --transport stdio --unity-project-path test-project",
    "smoke:security": "tsx server/src/securitySmoke.ts --transport stdio --unity-project-path test-project",
    "smoke:runtime": "tsx server/src/runtimeSmoke.ts --transport stdio --unity-project-path test-project",
    "smoke:scenario": "tsx server/src/scenarioSmoke.ts --transport stdio --unity-project-path test-project",
    "test": "node --import tsx --test \"server/test/**/*.test.ts\"",
    "test:course": "tsx server/src/courseSmoke.ts --transport stdio --unity-project-path test-project --request-timeout-ms 60000",
    "test:course:live": "tsx server/scripts/runLiveCourse.ts",
    "test:protocol": "npm run check:catalog && node --import tsx --test server/test/protocol.test.ts",
    "test:unity:concurrent": "tsx server/src/concurrentEditorsSmoke.ts",
    "test:unity:concurrent:cancel": "tsx server/src/concurrentEditorsSmoke.ts --self-cancel-after-ready",
    "test:unity:editmode": "tsx server/scripts/runUnityTests.ts EditMode",
    "test:unity:playmode": "tsx server/scripts/runUnityTests.ts PlayMode",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run build && npm run check:catalog && tsx server/scripts/checkRelease.ts",
    "release:pack": "npm pack --dry-run"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/generated/operation-catalog.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
